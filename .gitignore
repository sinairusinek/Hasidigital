# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# macOS
.DS_Store
__MACOSX/

# Secrets / env (never commit)
.env
.env.*
.zenodo_token
.zenodo_token_sandbox

# Archives
*.zip

# Large data files (local only)
Authorities/integration_tool/data/
*.csv.bak

# tag-audit embedding cache (regenerable)
editions/tag-audit/.cache/

# duplicate-detection embedding cache (regenerable)
editions/.cache/

# tag-audit volatile run artifacts (regenerable)
editions/tag-audit/**/.progress.json
editions/tag-audit/**/*.log
editions/tag-audit/**/adjudication-queue*.tsv
editions/tag-audit/**/*.prefix.bak

# Worktrees (local)
.worktrees/

# Root-level run logs (regenerable)
correction-run.log
run_corrections.log

# Incoming editions: page images & upload staging (too large for git; XMLs ARE tracked)
editions/incoming/**/*.jpg
editions/incoming/for-upload/

# Backup files
*.bak

# tag-audit rerun logs & chain outputs (volatile)
editions/tag-audit/.rerun-logs/

# Local-only Claude settings
.claude/settings.local.json

# Zenodo deposit bundles are rebuilt by build_zenodo_deposit.py
zenodo/**/*.zip

# Superseded dated edition snapshots (kept locally; the current editions are
# in editions/online/ and the article's frozen copies in the Zenodo deposit)
editions/archived-editions/

# Working notes & personal scratch (not part of the pipeline)
next-session-prompt.md
TODO-HASIDIGITAL.md
**/NEXT-SESSION.md
.claude/launch.json
.claude/plans/
Hasidic_Tales_Final/tmp.json
launch_shidduch.sh
apply_nisba_fix.py
