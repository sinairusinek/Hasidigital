# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# macOS
.DS_Store
__MACOSX/

# Secrets / env (never commit)
.env
.env.*
.zenodo_token
.zenodo_token_sandbox

# Archives
*.zip

# Large data files (local only)
Authorities/integration_tool/data/
*.csv.bak

# tag-audit embedding cache (regenerable)
editions/tag-audit/.cache/

# duplicate-detection embedding cache (regenerable)
editions/.cache/

# tag-audit volatile run artifacts (regenerable)
editions/tag-audit/**/.progress.json
editions/tag-audit/**/*.log
editions/tag-audit/**/adjudication-queue*.tsv
editions/tag-audit/**/*.prefix.bak

# Worktrees (local)
.worktrees/

# Root-level run logs (regenerable)
correction-run.log
run_corrections.log

# Incoming editions: page images & upload staging (too large for git; XMLs ARE tracked)
editions/incoming/**/*.jpg
editions/incoming/for-upload/

# Backup files
*.bak

# tag-audit rerun logs & chain outputs (volatile)
editions/tag-audit/.rerun-logs/

# Local-only Claude settings
.claude/settings.local.json
