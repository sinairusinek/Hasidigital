            </TextLine>
            <TextLine id="line_3" custom="readingOrder {index:2;}">
                <Coords points="20,294 1168,290 1154,231 20,234"/>
                <Baseline points="29,277 1172,264"/>
                <TextEquiv>
                    <Unicode>והרעיש במתיבתא דרקיע וילכו שניהם לעוה״ז בגלגול ונולד זה בן לעני</Unicode>
