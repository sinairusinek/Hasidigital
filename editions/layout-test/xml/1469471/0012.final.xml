            <TextLine id="line_2" custom="readingOrder {index:1;}">
                <Coords points="17,233 1165,230 1157,173 17,198"/>
                <Baseline points="26,223 1168,213"/>
                <TextEquiv>
                    <Unicode>את חובו ע"י פרוטות אשר יבא לקבץ מאתו פעם בפעם. ומשפט הזה הרעים</Unicode>
