            </TextLine>
            <TextLine id="line_4" custom="readingOrder {index:3;}">
                <Coords points="17,351 1167,333 1138,281 17,294"/>
                <Baseline points="26,328 1171,317"/>
                <TextEquiv>
                    <Unicode>ואביון וזה אצל גביר נגיד ועשיר וכאשר נתגדלו זה בעיר אחרת וזה במדינה</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_5" custom="readingOrder {index:4;}">
                <Coords points="25,397 1170,384 1139,329 25,352"/>
                <Baseline points="33,379 1173,369"/>
