            </TextLine>
            <TextLine id="line_28" custom="readingOrder {index:27;}">
                <Coords points="153,1676 1136,1682 1136,1621 1075,1614 153,1628"/>
                <Baseline points="162,1668 1138,1662"/>
                <TextEquiv>
                    <Unicode>היה ובכל מקום אשר עמד צלמי ע״ז על פרשת הדרכים עשה</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_29" custom="readingOrder {index:28;}">
                <Coords points="152,1738 1313,1724 1254,1657 152,1689"/>
                <Baseline points="160,1720 1316,1713"/>
                <TextEquiv>
                    <Unicode>כל השתדלות וטצדקות לכתת אותם עד אשר דק והי' כאשר ירא מעשות</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_30" custom="readingOrder {index:29;}">
                <Coords points="152,1791 1311,1780 1311,1725 1259,1720 152,1738"/>
                <Baseline points="160,1771 1315,1764"/>
                <TextEquiv>
                    <Unicode>יומם. נסע כל הלילות ועד נצח לא ידע שבעה וצמאה נפשו אל זאת</Unicode>
