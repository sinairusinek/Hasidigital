                </TextEquiv>
            </TextLine>
            <TextLine id="line_13" custom="readingOrder {index:12;}">
                <Coords points="62,811 1215,808 1199,753 62,774"/>
                <Baseline points="71,802 1218,793"/>
                <TextEquiv>
                    <Unicode>אל נכון כי ידיו עשו זאת לשבר את הצלם ההוא ויגשוהו אל המשפט ונחרץ</Unicode>
