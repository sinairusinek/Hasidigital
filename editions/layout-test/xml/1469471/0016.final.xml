            </TextLine>
            <TextLine id="line_11" custom="readingOrder {index:10;}">
                <Coords points="67,721 1211,708 1211,660 1060,652 67,657"/>
                <Baseline points="74,698 1215,690"/>
                <TextEquiv>
                    <Unicode>הקרובה אליו ויבקר את המוכסן אם הוא הולך בהיארמעלקי וימצא כי אין</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_12" custom="readingOrder {index:11;}">
                <Coords points="68,758 1215,761 1199,703 68,716"/>
                <Baseline points="76,747 1218,742"/>
                <TextEquiv>
