            </TextLine>
            <TextLine id="line_6" custom="readingOrder {index:5;}">
                <Coords points="330,563 1254,557 1228,493 330,515"/>
                <Baseline points="338,543 1258,533"/>
                <TextEquiv>
                    <Unicode>ומרחיבו כי הוא המביא שפלים למרום וקודרים שגבו ישע :</Unicode>
