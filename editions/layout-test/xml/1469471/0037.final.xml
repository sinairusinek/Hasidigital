                <Baseline points="225,860 697,849 1376,843"/>
                <TextEquiv>
                    <Unicode>בחור חריף ויתן לו די מחסורו תיכף ויעשה לו מלבושים וגם נדן לביתו</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_12" custom="readingOrder {index:11;}">
