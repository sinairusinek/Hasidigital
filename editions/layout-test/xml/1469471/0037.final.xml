            </TextLine>
            <TextLine id="line_7" custom="readingOrder {index:6;}">
                <Coords points="226,662 1366,656 1337,595 569,613 453,562 226,569"/>
                <Baseline points="234,650 937,639 1187,639 1369,646"/>
                <TextEquiv>
                    <Unicode>הגאון הצדיק הלזה בימי בחרותו למד בישיבה והתראה עצמו לנר</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_8" custom="readingOrder {index:7;} reg {offset:41; length:4;reg:הנוהג;}">
                <Coords points="214,729 733,693 1160,714 1203,655 266,679 215,650"/>
                <Baseline points="222,703 596,693 1206,688"/>
                <TextEquiv>
                    <Unicode>ישראל כי יהל יזהיר עיני הדור. והנה כמנהג הנהג אז כי כל</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_9" custom="readingOrder {index:8;}">
                <Coords points="215,765 1372,752 1372,701 1311,698 215,730"/>
                <Baseline points="224,755 691,745 1376,740"/>
                <TextEquiv>
                    <Unicode>איש נסע אל הישיבה ויבקש לו עלם משכיל נעים חריף ושנון כי אז לא ידענו</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_10" custom="readingOrder {index:9;}">
                <Coords points="215,822 1372,818 1374,752 215,776"/>
                <Baseline points="224,806 874,794 1376,792"/>
                <TextEquiv>
                    <Unicode>לשית הכסף לבעל. אך כל אשר הי' לו עלמה בתולה חבש עבורה בישיבה</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_11" custom="readingOrder {index:10;}">
