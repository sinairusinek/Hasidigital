            </TextLine>
            <TextLine id="line_4" custom="readingOrder {index:3;} story {offset:0; length:4;n:10;}">
                <Coords points="211,461 1366,450 1366,387 1314,381 211,410"/>
                <Baseline points="219,442 907,431 1166,431 1369,438"/>
                <TextEquiv>
                    <Unicode>ועתה אספר מעשה קדומה מהצדיק הקדוש מוהר"ש וויענער והיא</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_5" custom="readingOrder {index:4;}">
                <Coords points="202,514 1168,492 1168,450 1033,442 202,469"/>
                <Baseline points="210,496 660,484 1170,481"/>
                <TextEquiv>
                    <Unicode>הנוגעת לכמה שרשים וענפים מיסודי הנפש ומגדילה את הבטחון.</Unicode>
