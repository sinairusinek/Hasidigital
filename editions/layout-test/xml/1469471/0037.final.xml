            </TextLine>
            <TextLine id="line_2" custom="readingOrder {index:1;} sic {offset:28; length:6;correction:ותרמית;}">
                <Coords points="212,240 1363,236 1363,182 212,208"/>
                <Baseline points="221,232 1367,223"/>
                <TextEquiv>
                    <Unicode>לא ראהו ולא ידעהו השליח הזה ותרמות לבבו עד כה הביאהו. וד׳ לא יעזבנו</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="line_3" custom="readingOrder {index:2;}">
                <Coords points="409,297 524,314 861,282 1093,306 1154,290 1155,237 409,242"/>
                <Baseline points="417,282 1157,275"/>
                <TextEquiv>
                    <Unicode>כי בשאט נפש עשה הדבר הזה ועתה יגרש לבז :</Unicode>
